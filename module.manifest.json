{
  "$schema": "https://sjgant80-hub.github.io/onehub/modules/manifest.schema.json",
  "name": "fallreach",
  "version": "1.0.0",
  "publisher": "AI-Native Solutions",
  "publisher_url": "https://www.ai-nativesolutions.com/",
  "licence": "MIT",
  "description": "Autonomous outreach + comms orchestrator. Channel-agnostic review queue with swipe-to-approve. 30-minute auto-send after approval. LinkedIn (via fallscout) + email + WhatsApp + Instagram + TikTok + Fiverr + Upwork + Gmail.",
  "provides": [
    "autonomous_outreach",
    "review_queue",
    "multichannel_send",
    "approval_workflow"
  ],
  "tools": [
    {
      "name": "queue_outreach",
      "description": "Queue an outbound message for approval",
      "parameters": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "enum": ["linkedin", "email", "whatsapp", "instagram", "tiktok", "fiverr", "upwork", "gmail"] },
          "recipient": { "type": "string" },
          "message": { "type": "string" },
          "context": { "type": "object" }
        },
        "required": ["channel", "recipient", "message"]
      },
      "guardrails": { "auto_low": true, "max_value_gbp": 0 },
      "reversible_ms": 1800000
    },
    {
      "name": "approve_and_send",
      "description": "Mark a queued outreach approved (auto-sends 30 minutes later)",
      "parameters": {
        "type": "object",
        "properties": { "id": { "type": "string" } },
        "required": ["id"]
      },
      "guardrails": { "auto_low": false, "auto_med": true },
      "reversible_ms": 1800000
    },
    {
      "name": "score_prospect",
      "description": "Multi-lane adaptive scoring across ICPs (per gospel be-water-adaptive-targeting)",
      "parameters": {
        "type": "object",
        "properties": { "prospect_id": { "type": "string" } },
        "required": ["prospect_id"]
      },
      "guardrails": { "always_auto": true },
      "reversible_ms": 0
    }
  ],
  "kernel_extension": {
    "outreach_config": {
      "channels_enabled": [],
      "auto_send_delay_ms": 1800000,
      "daily_send_cap": 50
    }
  },
  "compatible_verticals": ["adshop", "consulting", "e-com", "trades", "*"],
  "requires": ["byok_adapter@>=1.0.0", "kernel", "events"],
  "ui_surfaces": ["modules/fallreach/queue.html"],
  "js_entrypoint": "modules/fallreach/index.js",
  "mit": true,
  "konomi_seal": "◊·κ=1",
  "estate": true
}
